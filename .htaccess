<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Rewrite /jobs-and-internships to careers.html
  RewriteRule ^jobs-and-internships/?$ careers.html [L]
  
  # Optional: Remove .html extension from all files
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)\.html$ $1 [L,R=301]
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)/?$ $1.html [L]
</IfModule>
